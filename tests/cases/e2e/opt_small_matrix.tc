int cell(int row, int column) {
    if (row == 0) {
        if (column == 0) return 1;
        if (column == 1) return 2;
        return 3;
    }
    if (row == 1) {
        if (column == 0) return 4;
        if (column == 1) return 5;
        return 6;
    }
    if (column == 0) return 7;
    if (column == 1) return 8;
    return 9;
}

int main() {
    int row = 0;
    int sum = 0;
    while (row < 3) {
        int column = 0;
        while (column < 3) {
            sum = sum + cell(row, column);
            column = column + 1;
        }
        row = row + 1;
    }
    return sum;
}
